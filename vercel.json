{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bunx expo export -p web && node scripts/precache.mjs dist",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/acoes/:id", "destination": "/acoes/[id]" },
    { "source": "/propostas/:id", "destination": "/propostas/[id]" },
    { "source": "/votacao/:id", "destination": "/votacao/[id]" },
    { "source": "/plano/:sq", "destination": "/plano/[sq]" }
  ],
  "headers": [
    {
      "source": "/precache.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
