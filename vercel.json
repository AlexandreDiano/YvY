{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "rm -rf node_modules && bun install --frozen-lockfile",
  "buildCommand": "bunx expo export -p web && node scripts/precache.mjs dist",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/acoes/:id",
      "destination": "/acoes/[id]"
    },
    {
      "source": "/propostas/:id",
      "destination": "/propostas/[id]"
    },
    {
      "source": "/votacao/:id",
      "destination": "/votacao/[id]"
    },
    {
      "source": "/plano/:sq",
      "destination": "/plano/[sq]"
    },
    {
      "source": "/conversas/:id",
      "destination": "/conversas/[id]"
    },
    {
      "source": "/ecidadania/pesquisamateria",
      "destination": "https://www12.senado.leg.br/ecidadania/pesquisamateria"
    },
    {
      "source": "/monitoring",
      "destination": "https://o4512244334002176.ingest.us.sentry.io/api/4512244336164864/envelope/"
    },
    {
      "source": "/csp-report",
      "destination": "https://o4512244334002176.ingest.us.sentry.io/api/4512244336164864/security/?sentry_key=6689f719bbaaa0d02e29c9854463eb2d"
    }
  ],
  "headers": [
    {
      "source": "/precache.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://viacep.com.br https://nominatim.openstreetmap.org https://api.queridodiario.org.br https://*.leg.br https://*.gov.br; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /csp-report"
        }
      ]
    }
  ]
}
