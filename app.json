{
  "expo": {
    "name": "YvY",
    "slug": "yvy",
    "version": "0.1.0",
    "scheme": "yvy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF3DF",
    "primaryColor": "#1E7440",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.yvy.mobile",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      }
    },
    "android": {
      "package": "app.yvy.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FBF3DF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": "development"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FBF3DF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#13251A"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O YvY usa a câmera para ler o QRCode de convite e, se você quiser, para tirar a foto de um post.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O YvY acessa suas fotos só quando você anexa uma imagem a um post da Base.",
          "cameraPermission": "O YvY usa a câmera só quando você escolhe tirar a foto de um post na hora."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O YvY usa sua localização aproximada (precisão de bairro) para mostrar ações perto de você. Nunca guardamos sua rua exata.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "O YvY adiciona ao seu calendário as ações em que você confirmou presença, só quando você pede."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2D5A27"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O YvY usa o Face ID só para destrancar o app, se você ligar essa opção em Perfil."
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "084e6303-b641-4808-b6f8-0387a389b522"
      }
    },
    "owner": "dianooos-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/084e6303-b641-4808-b6f8-0387a389b522",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
