# Supabase — projeto criado por você em supabase.com (nunca comitar o .env real)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Data do 2o turno (usada na contagem regressiva). ISO, horario de Brasilia.
EXPO_PUBLIC_ELECTION_DATE=2026-10-25T08:00:00-03:00

# Mapbox. Token publico (pk.*) do mapa de acoes. O mapa so entra na fase 3,
# com build nativo — ver src/features/actions/ActionsMap.tsx.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Repositorio publico mostrado na tela Perfil > Codigo-fonte
EXPO_PUBLIC_REPO_URL=https://github.com/SEU-USUARIO/yvy
# Endereço do site/PWA (ex.: https://yvy.vercel.app). Vira o link do QRCode de
# convite; sem ele, o QRCode do APK só é lido pelo próprio app.
EXPO_PUBLIC_SITE_URL=

# Apoio por Pix (Perfil, só membros). Prefira chave ALEATÓRIA: CPF, telefone
# ou e-mail aqui iriam dentro do app para qualquer membro ver.
EXPO_PUBLIC_PIX_KEY=
EXPO_PUBLIC_PIX_NAME=YvY
EXPO_PUBLIC_PIX_CITY=BRASIL
# Instagram de contato no rodapé do Perfil, sem @
EXPO_PUBLIC_INSTAGRAM=dianooxz

# --- Server-side only. NAO prefixar com EXPO_PUBLIC_. Usado pelo teste de RLS. ---
SUPABASE_SERVICE_ROLE_KEY=
